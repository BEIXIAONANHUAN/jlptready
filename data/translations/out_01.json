 {
  "rowid": "rb:ている:05:0",
  "meaning_zh": "表示动作正在进行、结果的持续或习惯的反复，含义取决于动词类型：持续动词表进行中，瞬间动词表结果状态，搭配频率词表习惯。",
  "ex1_ja": "今、ご飯を食べています。",
  "ex1_zh": "现在正在吃饭。",
  "ex2_ja": "毎日、日本語を勉強しています。",
  "ex2_zh": "每天学习日语。",
  "theme_order": 1,
  "pos": "时间先后"
 },
 {
  "rowid": "rb:ない形:06:0",
  "ex1_ja": "彼は朝ごはんを食べない。",
  "ex1_zh": "他不吃早饭。",
  "ex2_ja": "明日は何もしない。",
  "ex2_zh": "明天什么都不做。",
  "theme_order": 16,
  "pos": "其他/杂项"
 },
 {
  "rowid": "rb:のだ:15:0",
  "meaning_zh": "「のだ／んだ」用于说明情况、解释原因、强调事实或寻求说明，是日语最重要的语气表达之一。",
  "ex1_ja": "どうして遅れたの？――バスが来なかったんです。",
  "ex1_zh": "为什么迟到了？——因为公交车没来。",
  "ex2_ja": "この料理は美味しいんだよ。",
  "ex2_zh": "这个菜很好吃哦。",
  "theme_order": 5,
  "pos": "形式体言"
 },
 {
  "rowid": "jk:i-adjective-nonpast",
  "pattern": "い形容词（非过去肯定形）",
  "meaning_zh": "い形容词表示事物的性质、状态，词尾为「い」，可单独作谓语；敬体句末加「です」（是礼貌标记，非过去否定用「〜くないです」）。",
  "ex1_zh": "这本书很贵。",
  "ex2_zh": "那部电影很有趣。（简体）",
  "theme_order": 16,
  "pos": "其他/杂项"
 },
